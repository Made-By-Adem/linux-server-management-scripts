# =============================================================================
# Kernel Hardening Configuration
# =============================================================================
# This file is generated by the server baseline installation script
# Generated on: {{GENERATION_DATE}}
# Configuration profile: {{CONFIG_PROFILE_NAME}}
#
# Location: /etc/sysctl.d/99-server-hardening.conf
#
# Apply changes: sudo sysctl -p /etc/sysctl.d/99-server-hardening.conf
# View current values: sudo sysctl -a | grep <parameter>
# =============================================================================

# =============================================================================
# NETWORK SECURITY
# =============================================================================

# Enable reverse path filtering (anti-spoofing)
# 0 = disabled, 1 = strict mode, 2 = loose mode
net.ipv4.conf.all.rp_filter = {{SYSCTL_RP_FILTER}}
net.ipv4.conf.default.rp_filter = {{SYSCTL_RP_FILTER}}

# Disable ICMP redirect acceptance (prevent MITM attacks)
net.ipv4.conf.all.accept_redirects = {{SYSCTL_ACCEPT_REDIRECTS}}
net.ipv4.conf.default.accept_redirects = {{SYSCTL_ACCEPT_REDIRECTS}}
net.ipv6.conf.all.accept_redirects = {{SYSCTL_ACCEPT_REDIRECTS}}
net.ipv6.conf.default.accept_redirects = {{SYSCTL_ACCEPT_REDIRECTS}}

# Disable source packet routing (prevent IP spoofing)
net.ipv4.conf.all.accept_source_route = {{SYSCTL_ACCEPT_SOURCE_ROUTE}}
net.ipv4.conf.default.accept_source_route = {{SYSCTL_ACCEPT_SOURCE_ROUTE}}
net.ipv6.conf.all.accept_source_route = {{SYSCTL_ACCEPT_SOURCE_ROUTE}}
net.ipv6.conf.default.accept_source_route = {{SYSCTL_ACCEPT_SOURCE_ROUTE}}

# Log suspicious packets (martians)
net.ipv4.conf.all.log_martians = {{SYSCTL_LOG_MARTIANS}}
net.ipv4.conf.default.log_martians = {{SYSCTL_LOG_MARTIANS}}

# Ignore ICMP echo requests (ping)
# 0 = respond to ping, 1 = ignore ping
net.ipv4.icmp_echo_ignore_all = {{SYSCTL_ICMP_ECHO_IGNORE}}

# Ignore ICMP broadcast requests
net.ipv4.icmp_echo_ignore_broadcasts = 1

# Enable TCP SYN cookies (SYN flood protection)
net.ipv4.tcp_syncookies = {{SYSCTL_TCP_SYNCOOKIES}}
net.ipv4.tcp_max_syn_backlog = {{SYSCTL_TCP_MAX_SYN_BACKLOG}}
net.ipv4.tcp_synack_retries = {{SYSCTL_TCP_SYNACK_RETRIES}}
net.ipv4.tcp_syn_retries = {{SYSCTL_TCP_SYN_RETRIES}}

# Disable TCP timestamps (prevent uptime fingerprinting)
# Note: Disabling may impact performance in some scenarios
net.ipv4.tcp_timestamps = 0

# =============================================================================
# IP FORWARDING (Required for Docker)
# =============================================================================

# Enable IP forwarding (needed for Docker networking)
# 0 = disabled, 1 = enabled
net.ipv4.conf.all.forwarding = {{SYSCTL_IP_FORWARD}}
net.ipv4.ip_forward = {{SYSCTL_IP_FORWARD}}

# =============================================================================
# CONNECTION TRACKING
# =============================================================================

# Maximum number of tracked connections
# CRITICAL: High value needed for QUIC protocol (HTTP/3) and Cloudflare Tunnel
# Default: 65536, Recommended for QUIC: 524288
net.netfilter.nf_conntrack_max = {{SYSCTL_CONNTRACK_MAX}}

# =============================================================================
# FILE SYSTEM SECURITY
# =============================================================================

# Disable core dumps for setuid programs
# 0 = disabled, 1 = enabled (debug mode only), 2 = enabled with restrictions
fs.suid_dumpable = 0

# Restrict dmesg access to root only
kernel.dmesg_restrict = {{SYSCTL_DMESG_RESTRICT}}

# =============================================================================
# KERNEL SECURITY
# =============================================================================

# Disable magic SysRq key (prevents unauthorized system control)
# 0 = disabled, 1 = enabled (debug only)
kernel.sysrq = 0

# Restrict access to kernel logs
kernel.printk = 3 3 3 3

# Hide kernel pointers in /proc
# 0 = visible (debug), 1 = hidden from non-root, 2 = always hidden
kernel.kptr_restrict = {{SYSCTL_KPTR_RESTRICT}}

# Disable unprivileged BPF (Berkeley Packet Filter)
kernel.unprivileged_bpf_disabled = {{SYSCTL_UNPRIVILEGED_BPF_DISABLED}}

# Restrict kernel profiling to CAP_PERFMON
kernel.perf_cpu_time_max_percent = 1
kernel.perf_event_max_sample_rate = 1

# BPF JIT hardening
# 0 = disabled, 1 = enabled (QUIC compatible), 2 = full hardening
net.core.bpf_jit_harden = {{SYSCTL_BPF_JIT_HARDEN}}

# Restrict performance events
# -1 = no restriction, 0 = CAP_PERFMON, 1 = CAP_SYS_ADMIN, 2 = no access, 3 = kernel only
kernel.perf_event_paranoid = {{SYSCTL_PERF_EVENT_PARANOID}}

# =============================================================================
# FILE SYSTEM PROTECTIONS
# =============================================================================

# Protect hardlinks (prevent privilege escalation)
fs.protected_hardlinks = 1

# Protect symlinks (prevent symlink attacks)
fs.protected_symlinks = 1

# Protect FIFOs
fs.protected_fifos = 2

# Protect regular files
fs.protected_regular = 2

# =============================================================================
# MEMORY MANAGEMENT
# =============================================================================

# Virtual memory statistics interval (seconds)
vm.stat_interval = 60

# Swappiness (0-100)
# Lower = keep more in RAM, Higher = use swap more readily
# 10 = prefer RAM (servers), 60 = balanced (desktop)
vm.swappiness = {{SYSCTL_VM_SWAPPINESS}}

# VFS cache pressure (0-1000)
# Lower = keep cache longer, Higher = reclaim cache sooner
vm.vfs_cache_pressure = {{SYSCTL_VFS_CACHE_PRESSURE}}

# Dirty page writeback time (centiseconds)
vm.dirty_writeback_centisecs = 1500

# Overcommit memory handling
# 0 = heuristic (default), 1 = always, 2 = never
vm.overcommit_memory = 0
vm.overcommit_ratio = 50

# =============================================================================
# PROCESS RESTRICTIONS
# =============================================================================

# Restrict ptrace to same UID processes only (prevent debugging attacks)
# 0 = classic ptrace, 1 = restricted, 2 = admin only, 3 = no ptrace
kernel.yama.ptrace_scope = {{SYSCTL_PTRACE_SCOPE}}

# =============================================================================
# IPv6 CONFIGURATION
# =============================================================================

# Disable IPv6 router advertisements
net.ipv6.conf.all.accept_ra = 0
net.ipv6.conf.default.accept_ra = 0

# Disable IPv6 autoconfiguration
net.ipv6.conf.all.autoconf = 0
net.ipv6.conf.default.autoconf = 0

# =============================================================================
# ARP SECURITY
# =============================================================================

# ARP flux protection
net.ipv4.conf.all.arp_ignore = 1
net.ipv4.conf.all.arp_announce = 2

# =============================================================================
# TCP/IP PERFORMANCE TUNING
# =============================================================================

# TCP window scaling
net.ipv4.tcp_window_scaling = 1

# TCP selective acknowledgments
net.ipv4.tcp_sack = 1

# TCP fast open (requires client support)
net.ipv4.tcp_fastopen = 3

# Maximum socket receive/send buffer
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216

# Default socket receive/send buffer
net.core.rmem_default = 262144
net.core.wmem_default = 262144

# TCP receive/send buffer auto-tuning
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216

# Maximum backlog of incoming connections
net.core.netdev_max_backlog = 5000

# Maximum number of open sockets waiting to be connected
net.core.somaxconn = 1024

# =============================================================================
# ADDITIONAL HARDENING
# =============================================================================

# Prevent kernel from panicking on certain errors
kernel.panic = 10
kernel.panic_on_oops = 1

# Restrict loading of TTY line disciplines
dev.tty.ldisc_autoload = 0

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
