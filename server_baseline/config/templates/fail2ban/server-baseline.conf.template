# =============================================================================
# Fail2ban Jail Configuration - Server Baseline
# =============================================================================
# This file is generated by the server baseline installation script
# Generated on: {{GENERATION_DATE}}
# Configuration profile: {{CONFIG_PROFILE_NAME}}
#
# Location: /etc/fail2ban/jail.d/server-baseline.conf
#
# This configuration provides SSH protection with customizable ban times
# and retry limits based on your security profile.
#
# Check status: sudo fail2ban-client status sshd
# Unban IP: sudo fail2ban-client set sshd unbanip <IP>
# =============================================================================

[DEFAULT]
# Default ban time for all jails (seconds)
# Can be overridden per jail
bantime = {{FAIL2BAN_DEFAULT_BANTIME}}

# Time window in which maxretry failures trigger a ban (seconds)
findtime = {{FAIL2BAN_DEFAULT_FINDTIME}}

# Number of failures before an IP is banned
maxretry = {{FAIL2BAN_DEFAULT_MAXRETRY}}

# =============================================================================
# SSH JAIL
# =============================================================================

[sshd]
# Enable SSH jail
enabled = true

# Ports to monitor (supports both standard and custom SSH ports)
port = ssh,{{SSH_OLD_PORT}},{{SSH_NEW_PORT}}

# Filter to use (reads /etc/fail2ban/filter.d/sshd.conf)
filter = sshd

# Log file to monitor
logpath = /var/log/auth.log

# SSH-specific settings (stricter than default)
maxretry = {{FAIL2BAN_SSH_MAXRETRY}}
bantime = {{FAIL2BAN_SSH_BANTIME}}
findtime = {{FAIL2BAN_SSH_FINDTIME}}

# Ban action (iptables-multiport is used for multiple ports)
banaction = iptables-multiport

# Additional ban action - send email notification (optional)
# Uncomment and configure if email notifications are set up
# action = %(action_mwl)s

# =============================================================================
# ADDITIONAL NOTES
# =============================================================================
#
# Profile-Specific Settings:
#
# Default Profile:
#   - maxretry: 3 attempts
#   - bantime: 7200 seconds (2 hours)
#   - findtime: 600 seconds (10 minutes)
#
# Production Profile:
#   - maxretry: 2 attempts (stricter)
#   - bantime: 86400 seconds (24 hours)
#   - findtime: 1800 seconds (30 minutes)
#
# Development Profile:
#   - maxretry: 10 attempts (lenient)
#   - bantime: 600 seconds (10 minutes)
#   - findtime: 1800 seconds (30 minutes)
#
# Raspberry Pi Profile:
#   - Same as default
#
# =============================================================================
# WHITELIST YOUR OWN IP
# =============================================================================
#
# To prevent locking yourself out, add your IP to the whitelist:
#
# 1. Edit /etc/fail2ban/jail.local
# 2. Add under [DEFAULT] section:
#    ignoreip = 127.0.0.1/8 ::1 YOUR.IP.ADDRESS.HERE
#
# Example:
#    ignoreip = 127.0.0.1/8 ::1 192.168.1.100 10.0.0.0/8
#
# =============================================================================
