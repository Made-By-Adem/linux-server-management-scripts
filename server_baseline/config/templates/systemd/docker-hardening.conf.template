[Service]
# Note: Docker requires many privileges, so hardening is limited

# Private /tmp
PrivateTmp=yes

# Restrict address families
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# No new privileges (disabled for Docker compatibility)
NoNewPrivileges=false
