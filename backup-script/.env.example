# Source server (IP or hostname)
REMOTE_HOST="192.168.1.100"

# Friendly name for the backup folder (e.g. "fireman", "webserver")
REMOTE_NAME="fireman"

# SSH user on the source server (must match the user that has the key in authorized_keys)
REMOTE_USER="admin"

# SSH port (default: 22)
SSH_PORT="22"

# SSH key path - use an absolute path, not $HOME or ~
SSH_KEY="/home/your-user/.ssh/id_ed25519"

# Local directory to store the backup (default: next to this script)
# BACKUP_DEST="/home/your-user/backups"

# Retention, in days, for files that rsync deletes or overwrites.
# rsync --delete mirrors the source: without retention, one run after the source
# is compromised or after an accidental deletion overwrites the last good copy.
# Superseded files are moved to <backup-dir>/.attic/<timestamp>/ and pruned after
# this many days. Set to 0 for the old mirror-only behaviour.
RETENTION_DAYS="30"

# SSH host key policy.
# "accept-new" (default) trusts any host not yet in known_hosts on first contact.
# For anything running from cron, seed known_hosts once and then set this to
# "yes" - a provider IP that gets released and re-issued to someone else is
# otherwise trusted silently.
#   ssh-keyscan -p "$SSH_PORT" "$REMOTE_HOST" >> ~/.ssh/known_hosts
# STRICT_HOST_KEY="yes"

# Telegram notifications (optional - leave empty to disable)
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
# TELEGRAM_CHAT_ID="123456789"

# Folders to backup from the remote server (one per line)
BACKUP_FOLDERS=(
    "/etc"
    "/home"
    "/opt/docker"
    "/var/lib/docker/volumes"
)
